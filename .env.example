# Copy to .env for local development
NODE_ENV=development

# MongoDB Atlas connection string (required in production)
ATLAS_DB=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Session secret (use a long random string)
SECRET=your_long_random_secret_here

# Cloudinary (https://cloudinary.com)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# MapTiler (https://cloud.maptiler.com)
MAP_TOKEN=your_maptiler_api_key
